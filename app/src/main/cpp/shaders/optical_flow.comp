#version 450

// Optical Flow Compute Shader (RAFT-inspired lightweight)
// Computes dense optical flow between two frames

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uFrame0;  // Previous frame
layout(set = 0, binding = 1) uniform sampler2D uFrame1;  // Current frame
layout(set = 0, binding = 2) uniform sampler2D uPyramid0; // Pyramid level 0
layout(set = 0, binding = 3) uniform sampler2D uPyramid1; // Pyramid level 1

layout(set = 1, binding = 0, rgba32f) uniform image2D uFlowOutput;    // Output flow (x, y, confidence, 0)
layout(set = 1, binding = 1, rgba32f) uniform image2D uPyramidOut0;  // Pyramid output

layout(push_constant) uniform PushConstants {
    float uTime;
    float uResolution[2];
    int uPyramidLevel;
    float uScale;
    int uIterations;
    float uSmoothness;
} pc;

float luminance(vec4 c) {
    return dot(c.rgb, vec3(0.299, 0.587, 0.114));
}

vec2 sampleGrad(sampler2D tex, vec2 uv, vec2 texelSize) {
    float dx = texture(tex, uv + vec2(texelSize.x, 0.0)).r - texture(tex, uv - vec2(texelSize.x, 0.0)).r;
    float dy = texture(tex, uv + vec2(0.0, texelSize.y)).r - texture(tex, uv - vec2(0.0, texelSize.y)).r;
    return vec2(dx, dy) * 0.5;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(uFlowOutput);
    
    if (pixel.x >= dims.x || pixel.y >= dims.y) return;
    
    vec2 uv = (vec2(pixel) + 0.5) / vec2(dims);
    vec2 texelSize = 1.0 / vec2(dims);
    
    // Sample frames
    float I0 = luminance(texture(uFrame0, uv));
    float I1 = luminance(texture(uFrame1, uv));
    
    // Spatial gradients
    vec2 gradI0 = sampleGrad(uFrame0, uv, texelSize);
    vec2 gradI1 = sampleGrad(uFrame1, uv, texelSize);
    
    // Temporal gradient
    float It = I1 - I0;
    
    // Structure tensor (Lucas-Kanade)
    vec2 grad = (gradI0 + gradI1) * 0.5;
    float Ixx = grad.x * grad.x;
    float Ixy = grad.x * grad.y;
    float Iyy = grad.y * grad.y;
    float Ixt = grad.x * It;
    float Iyt = grad.y * It;
    
    // Local window summation (simplified - single pixel)
    // In practice would use a window sum
    float det = Ixx * Iyy - Ixy * Ixy;
    
    vec2 flow = vec2(0.0);
    float confidence = 0.0;
    
    if (det > 0.0001) {
        flow.x = (Iyy * Ixt - Ixy * Iyt) / det;
        flow.y = (Ixx * Iyt - Ixy * Ixt) / det;
        confidence = 1.0 - exp(-det * 1000.0);
    }
    
    // Output
    imageStore(uFlowOutput, pixel, vec4(flow, confidence, 0.0));
}