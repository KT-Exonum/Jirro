#version 450

// Planar Tracker Compute Shader
// Tracks a planar region using corner detection + homography estimation

layout(local_size_x = 16, local_size_y = 16) in;

layout(set = 0, binding = 0) uniform sampler2D uFramePrev;
layout(set = 0, binding = 1) uniform sampler2D uFrameCurr;
layout(set = 0, binding = 2) uniform sampler2D uMask;       // Tracking region mask

layout(set = 1, binding = 0, rgba32f) uniform image2D uCornersOut;   // Output corners
layout(set = 1, binding = 1, rgba32f) uniform image2D uHomographyOut; // Output homography (3x3 matrix)

layout(push_constant) uniform PushConstants {
    float uTime;
    float uResolution[2];
    float uSearchRadius;
    int uMaxCorners;
    float uQualityLevel;
    float uMinDistance;
    int uFrameIndex;
} pc;

float harrisResponse(sampler2D tex, vec2 uv, vec2 texelSize, float k) {
    // Compute gradients
    vec2 dx = vec2(
        texture(tex, uv + vec2(texelSize.x, 0.0)).r - texture(tex, uv - vec2(texelSize.x, 0.0)).r,
        texture(tex, uv + vec2(texelSize.x, 0.0)).g - texture(tex, uv - vec2(texelSize.x, 0.0)).g
    ) * 0.5;
    
    vec2 dy = vec2(
        texture(tex, uv + vec2(0.0, texelSize.y)).r - texture(tex, uv - vec2(0.0, texelSize.y)).r,
        texture(tex, uv + vec2(0.0, texelSize.y)).g - texture(tex, uv - vec2(0.0, texelSize.y)).g
    ) * 0.5;
    
    float Ix = dx.x;
    float Iy = dy.y;
    
    float Ixx = Ix * Ix;
    float Ixy = Ix * Iy;
    float Iyy = Iy * Iy;
    
    // Simple box filter (in practice use separable box filter)
    float Sxx = Ixx;
    float Sxy = Ixy;
    float Syy = Iyy;
    
    float det = Sxx * Syy - Sxy * Sxy;
    float trace = Sxx + Syy;
    
    return det - k * trace * trace;
}

void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    ivec2 dims = imageSize(uCornersOut);
    
    if (pixel.x >= dims.x || pixel.y >= dims.y) return;
    
    vec2 uv = (vec2(pixel) + 0.5) / vec2(dims);
    vec2 texelSize = 1.0 / vec2(dims);
    
    // Check if in tracking mask
    float maskVal = texture(uMask, uv).r;
    if (maskVal < 0.5) {
        imageStore(uCornersOut, pixel, vec4(0.0));
        return;
    }
    
    // Harris corner detection
    float k = 0.04;
    float R = harrisResponse(uFrameCurr, uv, texelSize, k);
    
    // Threshold
    if (R > pc.uQualityLevel) {
        // Found corner
        imageStore(uCornersOut, pixel, vec4(uv.x, uv.y, R, 1.0));
    } else {
        imageStore(uCornersOut, pixel, vec4(0.0));
    }
}